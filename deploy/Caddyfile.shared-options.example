# Merge these options into the existing global block; never replace its contents.
{
	servers {
		timeouts {
			read_header 10s
		}
		max_header_size 32KB
	}
	# Runtime error logs can contain request fields even without access logging.
	log {
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				request>remote_ip delete
				request>client_ip delete
				request>remote_port delete
			}
		}
	}
}
