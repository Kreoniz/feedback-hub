{
	admin off
	persist_config off
	auto_https off
	servers {
		timeouts {
			read_header 5s
			read_body 10s
			write 20s
			idle 60s
		}
		max_header_size 16KB
	}
	# Do not retain request URIs or headers on error paths.
	log {
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				request>remote_ip delete
				request>client_ip delete
				request>remote_port delete
			}
		}
	}
}
http://:8080 {
	request_body {
		max_size 64KB
	}
	reverse_proxy app:8080 {
		header_up X-Forwarded-For {http.request.remote.host}
		header_up -Forwarded
		header_up -X-Real-IP
		transport http {
			dial_timeout 3s
			response_header_timeout 15s
		}
	}
}
